# SignalRAG Environment Variables

# LLM & Embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_PROVIDER=local  # local, openai, fastembed
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=openai       # openai, anthropic, ollama
LLM_MODEL=gpt-4o-mini

# Vector Store
VECTOR_STORE_TYPE=lancedb # lancedb, chroma, memory
VECTOR_STORE_PATH=./storage/vector_store

# Ingestion & Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
TOP_K=5
HYBRID_ALPHA=0.5
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Observability & Debug
DEBUG=false
LOG_LEVEL=INFO
